@*
    For simplicity, this example uses a single page with JavaScript for step navigation.
    In a real application, you might prefer to use separate views for each step
    and handle navigation on the server-side.
*@

@{
    ViewData["Title"] = "Wedding Setup";
    var steps = new[] {
        new { id = "basics", name = "Basic Information", fields = new[] { "date", "location" } },
        new { id = "info", name = "Couple Info", fields = new[] { "brideName", "groomName" } },
        new { id = "budget", name = "Budget Planning", fields = new[] { "totalBudget", "guestCount" } },
        new { id = "preferences", name = "Wedding Preferences", fields = new[] { "style", "color" } }
    };
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="text-center mb-4">
                <h1>Plan Your Dream Wedding</h1>
                <p class="text-muted">Let's get started with the basic details of your special day</p>
            </div>

            <!-- Progress Steps -->
            <div class="mb-4 pb-5">
                <div class="d-flex align-items-center justify-content-center">
                    @for (int i = 0; i < steps.Length; i++)
                    {
                        var step = steps[i];
                        if (i > 0)
                        {
                            <div class="progress w-25">
                                <div class="progress-bar bg-success" role="progressbar" style="width: @(i <= ViewBag.CurrentStep ? 100 : 0)%;" aria-valuenow="@(i <= ViewBag.CurrentStep ? 100 : 0)" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        }
                        <div class="position-relative d-inline-block">
                            <div class="rounded-circle d-flex align-items-center justify-content-center @(i < ViewBag.CurrentStep ? "bg-success text-white" : i == ViewBag.CurrentStep ? "bg-primary text-white" : "bg-secondary text-white")" style="width: 40px; height: 40px;">
                                @(i < ViewBag.CurrentStep ? "✔" : i == ViewBag.CurrentStep ? (ViewBag.CurrentStep + 1).ToString() : (i + 1).ToString())
                            </div>
                            <div class="position-absolute start-50 translate-middle-x text-sm font-medium text-center text-muted" style="margin-top: 10px;">
                                @step.name
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h2>@steps[ViewBag.CurrentStep].name</h2>
                </div>
                <form asp-action="Setup" method="post">
                    <div class="card-body">
                        <input type="hidden" name="step" value="@ViewBag.CurrentStep" />
                        @if (ViewBag.CurrentStep == 0)
                        {
                            <div class="mb-3">
                                <label for="date" class="form-label">Wedding Date</label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                       <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-calendar" viewBox="0 0 16 16">
                                        <path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5M1 4v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4z"/>
                                        </svg>
                                    </span>
                                    @* <input type="date" class="form-control" id="date" name="date" value="@TempData["date"]"> *@
                                    <input type="date" class="form-control" id="date" name="date"
       value="@(TempData["date"] != null ? DateTime.Parse(TempData["date"].ToString()).ToString("yyyy-MM-dd") : "")">
                                </div>
                            </div>
                            <div class="mb-3">
                                <label for="location" class="form-label">Wedding Location</label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-geo-alt" viewBox="0 0 16 16">
                                        <path d="M12.166 8.94c-.524 1.062-1.234 2.12-1.96 3.07A32 32 0 0 1 8 14.58a32 32 0 0 1-2.206-2.57c-.726-.95-1.436-2.008-1.96-3.07C3.304 7.867 3 6.862 3 6a5 5 0 0 1 10 0c0 .862-.305 1.867-.834 2.94M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10"/>
                                        <path d="M8 8a2 2 0 1 1 0-4 2 2 0 0 1 0 4m0 1a3 3 0 1 0 0-6 3 3 0 0 0 0 6"/>
                                        </svg>
                                    </span>
                                    <input type="text" class="form-control" id="location" name="location" placeholder="City, State" value="@TempData["location"]">
                                </div>
                            </div>
                        }
                        @if (ViewBag.CurrentStep == 1)
                        {
                            <div class="mb-3">
                                <label for="brideName" class="form-label">Bride Name</label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-gender-female" viewBox="0 0 16 16">
                                            <path fill-rule="evenodd" d="M8 1a4 4 0 1 0 0 8 4 4 0 0 0 0-8M3 5a5 5 0 1 1 5.5 4.975V12h2a.5.5 0 0 1 0 1h-2v2.5a.5.5 0 0 1-1 0V13h-2a.5.5 0 0 1 0-1h2V9.975A5 5 0 0 1 3 5"/>
                                        </svg>
                                    </span>
                                    <input type="text" class="form-control" id="brideName" name="brideName" placeholder="Enter your bride's name" value="@TempData["brideName"]">
                                </div>
                            </div>
                            <div class="mb-3">
                                <label for="groomName" class="form-label">Groom Name</label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-gender-male" viewBox="0 0 16 16">
                                            <path fill-rule="evenodd" d="M9.5 2a.5.5 0 0 1 0-1h5a.5.5 0 0 1 .5.5v5a.5.5 0 0 1-1 0V2.707L9.871 6.836a5 5 0 1 1-.707-.707L13.293 2zM6 6a4 4 0 1 0 0 8 4 4 0 0 0 0-8"/>
                                        </svg>
                                    </span>
                                    <input type="text" class="form-control" id="groomName" name="groomName" placeholder="Enter your groom's name" value="@TempData["groomName"]">
                                </div>
                            </div>
                        }
                        @if (ViewBag.CurrentStep == 2)
                        {
                            <div class="mb-3">
                                <label for="totalBudget" class="form-label">Total Budget</label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-currency-dollar" viewBox="0 0 16 16">
                                        <path d="M4 10.781c.148 1.667 1.513 2.85 3.591 3.003V15h1.043v-1.216c2.27-.179 3.678-1.438 3.678-3.3 0-1.59-.947-2.51-2.956-3.028l-.722-.187V3.467c1.122.11 1.879.714 2.07 1.616h1.47c-.166-1.6-1.54-2.748-3.54-2.875V1H7.591v1.233c-1.939.23-3.27 1.472-3.27 3.156 0 1.454.966 2.483 2.661 2.917l.61.162v4.031c-1.149-.17-1.94-.8-2.131-1.718zm3.391-3.836c-1.043-.263-1.6-.825-1.6-1.616 0-.944.704-1.641 1.8-1.828v3.495l-.2-.05zm1.591 1.872c1.287.323 1.852.859 1.852 1.769 0 1.097-.826 1.828-2.2 1.939V8.73z"/>
                                        </svg>
                                    </span>
                                    <input type="number" class="form-control" id="totalBudget" name="totalBudget" placeholder="Enter your budget" value="@TempData["totalBudget"]">
                                </div>
                            </div>
                            <div class="mb-3">
                                <label for="guestCount" class="form-label">Expected Guest Count</label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-people" viewBox="0 0 16 16">
                                        <path d="M15 14s1 0 1-1-1-4-5-4-5 3-5 4 1 1 1 1zm-7.978-1L7 12.996c.001-.264.167-1.03.76-1.72C8.312 10.629 9.282 10 11 10c1.717 0 2.687.63 3.24 1.276.593.69.758 1.457.76 1.72l-.008.002-.014.002zM11 7a2 2 0 1 0 0-4 2 2 0 0 0 0 4m3-2a3 3 0 1 1-6 0 3 3 0 0 1 6 0M6.936 9.28a6 6 0 0 0-1.23-.247A7 7 0 0 0 5 9c-4 0-5 3-5 4q0 1 1 1h4.216A2.24 2.24 0 0 1 5 13c0-1.01.377-2.042 1.09-2.904.243-.294.526-.569.846-.816M4.92 10A5.5 5.5 0 0 0 4 13H1c0-.26.164-1.03.76-1.724.545-.636 1.492-1.256 3.16-1.275ZM1.5 5.5a3 3 0 1 1 6 0 3 3 0 0 1-6 0m3-2a2 2 0 1 0 0 4 2 2 0 0 0 0-4"/>
                                        </svg>
                                    </span>
                                    <input type="number" class="form-control" id="guestCount" name="guestCount" placeholder="Number of guests" value="@TempData["guestCount"]">
                                </div>
                            </div>
                        }
                        @if (ViewBag.CurrentStep == 3)
                        {
                            <div class="mb-3">
                                <label for="style" class="form-label">Wedding Style</label>
                                <select class="form-select" id="style" name="style">
                                    <option value="">Select a style</option>
                                    @if (TempData["style"]?.ToString() == "traditional")
                                    {
                                        <option value="traditional" selected="selected">Traditional</option>
                                    }
                                    else
                                    {
                                        <option value="traditional">Traditional</option>
                                    }
                                    @if (TempData["style"]?.ToString() == "modern")
                                    {
                                        <option value="modern" selected="selected">Modern</option>
                                    }
                                    else
                                    {
                                        <option value="modern">Modern</option>
                                    }
                                    @if (TempData["style"]?.ToString() == "rustic")
                                    {
                                        <option value="rustic" selected="selected">Rustic</option>
                                    }
                                    else
                                    {
                                        <option value="rustic">Rustic</option>
                                    }
                                    @if (TempData["style"]?.ToString() == "beach")
                                    {
                                        <option value="beach" selected="selected">Beach</option>
                                    }
                                    else
                                    {
                                        <option value="beach">Beach</option>
                                    }
                                    @if (TempData["style"]?.ToString() == "garden")
                                    {
                                        <option value="garden" selected="selected">Garden</option>
                                    }
                                    else
                                    {
                                        <option value="garden">Garden</option>
                                    }
                                    @if (TempData["style"]?.ToString() == "vintage")
                                    {
                                        <option value="vintage" selected="selected">Vintage</option>
                                    }
                                    else
                                    {
                                        <option value="vintage">Vintage</option>
                                    }
                                </select>
                            </div>
                            <div class="mb-3">
                                <label for="color" class="form-label">Color Theme</label>
                                <select class="form-select" id="color" name="color">
                                    <option value="">Select a color theme</option>
                                    @if (TempData["color"]?.ToString() == "rose-gold")
                                    {
                                        <option value="rose-gold" selected="selected">Rose Gold</option>
                                    }
                                    else
                                    {
                                        <option value="rose-gold">Rose Gold</option>
                                    }
                                    @if (TempData["color"]?.ToString() == "classic-white")
                                    {
                                        <option value="classic-white" selected="selected">Classic White</option>
                                    }
                                    else
                                    {
                                        <option value="classic-white">Classic White</option>
                                    }
                                    @if (TempData["color"]?.ToString() == "navy-blush")
                                    {
                                        <option value="navy-blush" selected="selected">Navy & Blush</option>
                                    }
                                    else
                                    {
                                        <option value="navy-blush">Navy & Blush</option>
                                    }
                                    @if (TempData["color"]?.ToString() == "burgundy")
                                    {
                                        <option value="burgundy" selected="selected">Burgundy</option>
                                    }
                                    else
                                    {
                                        <option value="burgundy">Burgundy</option>
                                    }
                                    @if (TempData["color"]?.ToString() == "sage-green")
                                    {
                                        <option value="sage-green" selected="selected">Sage Green</option>
                                    }
                                    else
                                    {
                                        <option value="sage-green">Sage Green</option>
                                    }
                                    @if (TempData["color"]?.ToString() == "lavender")
                                    {
                                        <option value="lavender" selected="selected">Lavender</option>
                                    }
                                    else
                                    {
                                        <option value="lavender">Lavender</option>
                                    }
                                </select>
                            </div>
                        }

                        <div class="d-flex justify-content-between">
                            <button
                                type="button"
                                class="btn btn-outline-secondary"
                                onclick="location.href='@Url.Action("Setup", "Wedding", new { step = (int)ViewBag.CurrentStep - 1 })'"
                                @(ViewBag.CurrentStep == 0 ? "disabled" : "")>
                                Previous
                            </button>


                            <button type="submit" class="btn btn-primary" name="action" value="next">@(ViewBag.CurrentStep == steps.Length - 1 ? "Complete Setup" : "Next")</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // No JavaScript needed, form submission handles navigation
    </script>
}
