                            </div>
                        </div>
                        <div class="col">
                            <div class="p-4 bg-purple-50 rounded-lg">
                                <p class="text-3xl font-bold text-purple-600">@Model.AdminStates?.PendingVendors</p>
                                <p class="text-sm text-gray-600">Pending Approvals</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
