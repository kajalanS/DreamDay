@using DreamDay.Models
@model GuestListViewModel

@functions {
    string GetRsvpStatusBadgeClass(string? status) // Made status nullable
    {
        return status?.ToLower() switch
        {
            "confirmed" => "bg-success-subtle text-success-emphasis",
            "declined" => "bg-danger-subtle text-danger-emphasis",
            _ => "bg-warning-subtle text-warning-emphasis",
        };
    }
}

@if (Model == null)
{
    <div class="alert alert-warning">
        No guest data available.
    </div>
    return;
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 fw-bold text-dark">Guest List for Wedding: @Model.WeddingId</h1>
            <p class="mt-1 small text-muted">
                Manage your wedding guests and track RSVPs
            </p>
        </div>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addGuestModal">
            <i class="bi bi-plus-lg me-2"></i>Add Guest
        </button>
    </div>

    <!-- Guest Statistics -->
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-3 mb-4">
        <div class="col">
            <div class="card shadow-sm">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-light p-3 me-3">
                        <i class="bi bi-people fs-4 text-secondary"></i>
                    </div>
                    <div class="ms-3">
                        <h3 class="small text-muted mb-0">Total Guests</h3>
                        <p class="fs-4 fw-semibold text-dark mb-0">@(Model.GuestStats?.Total ?? 0)</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card shadow-sm">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-success-subtle p-3 me-3">
                        <i class="bi bi-check-circle fs-4 text-success"></i>
                    </div>
                    <div class="ms-3">
                        <h3 class="small text-muted mb-0">Confirmed</h3>
                        <p class="fs-4 fw-semibold text-dark mb-0">@(Model.GuestStats?.Confirmed ?? 0)</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card shadow-sm">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-warning-subtle p-3 me-3">
                        <i class="bi bi-person-fill fs-4 text-warning"></i>
                    </div>
                    <div class="ms-3">
                        <h3 class="small text-muted mb-0">Pending</h3>
                        <p class="fs-4 fw-semibold text-dark mb-0">@(Model.GuestStats?.Pending ?? 0)</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card shadow-sm">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-danger-subtle p-3 me-3">
                        <i class="bi bi-x-circle fs-4 text-danger"></i>
                    </div>
                    <div class="ms-3">
                        <h3 class="small text-muted mb-0">Declined</h3>
                        <p class="fs-4 fw-semibold text-dark mb-0">@(Model.GuestStats?.Declined ?? 0)</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Search and Filter -->
    <form method="get" asp-controller="Wedding" asp-action="GuestList" asp-route-id="@Model.WeddingId">
        <div class="d-flex flex-column flex-md-row gap-3 mb-4">
            <div class="input-group flex-grow-1">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" name="searchQuery" placeholder="Search guests..." value="@Model.SearchQuery"
                    class="form-control" />
            </div>
            <select name="selectedGroup" class="form-select" style="width: auto;" onchange="this.form.submit()">
                <option value="all" selected="@("all".Equals(Model.SelectedGroup, StringComparison.OrdinalIgnoreCase))">
                    All Groups</option>
                @if (Model.AllGroups != null)
                {
                    foreach (var group in Model.AllGroups)
                    {
                        <option value="@group"
                            selected="@group.Equals(Model.SelectedGroup, StringComparison.OrdinalIgnoreCase)">@group</option>
                    }
                }
            </select>
            <button type="submit" class="btn btn-outline-secondary">Filter</button>
        </div>
    </form>

    <!-- Guest List Table -->
    <div class="card shadow-sm">
        <div class="card-header">
            <h2 class="h5 mb-0 text-dark">Guests</h2>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="px-3 py-2 text-start text-uppercase small text-muted">Name</th>
                            <th class="px-3 py-2 text-start text-uppercase small text-muted">Contact</th>
                            <th class="px-3 py-2 text-start text-uppercase small text-muted">Group</th>
                            <th class="px-3 py-2 text-start text-uppercase small text-muted">RSVP Status</th>
                            <th class="px-3 py-2 text-start text-uppercase small text-muted">Plus One</th>
                            <th class="px-3 py-2 text-start text-uppercase small text-muted">Table</th>
                            <th class="px-3 py-2 text-end text-uppercase small text-muted">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Guests != null && Model.Guests.Any())
                        {
                            foreach (var guest in Model.Guests)
                            {
                                <tr>
                                    <td class="px-3 py-2 text-nowrap">
                                        <div class="fw-medium text-dark">@guest.Name</div>
                                    </td>
                                    <td class="px-3 py-2">
                                        <div class="small text-muted">@guest.Email</div>
                                        @if (!string.IsNullOrEmpty(guest.Phone))
                                        {
                                            <div class="small text-muted">@guest.Phone</div>
                                        }
                                    </td>
                                    <td class="px-3 py-2 text-nowrap">
                                        <div class="small text-muted">@(guest.Group ?? "-")</div>
                                    </td>
                                    <td class="px-3 py-2 text-nowrap">
                                        <span class="badge rounded-pill @GetRsvpStatusBadgeClass(guest.RsvpStatus)">
                                            @guest.RsvpStatus?.ToUpperInvariant()
                                        </span>
                                    </td>
                                    <td class="px-3 py-2 small text-muted">@(guest.PlusOne ? "Yes" : "No")</td>
                                    <td class="px-3 py-2 small text-muted">@(guest.TableAssignment?.ToString() ?? "-")</td>
                                    <td class="px-3 py-2 text-nowrap text-end">
                                        <a href="mailto:@guest.Email" class="btn btn-sm btn-outline-secondary me-2"
                                            title="Send Email">
                                            <i class="bi bi-envelope"></i>
                                        </a>
                                        <a asp-controller="Wedding" asp-action="EditGuest"
                                            asp-route-weddingId="@Model.WeddingId" asp-route-guestId="@guest.Id"
                                            class="btn btn-sm btn-outline-secondary" title="Edit Guest">
                                            Edit
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center p-4 text-muted">No guests found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Add Guest Modal -->
    <div class="modal fade" id="addGuestModal" tabindex="-1" aria-labelledby="addGuestModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <form asp-controller="Wedding" asp-action="AddGuest" asp-route-weddingId="@Model.WeddingId"
                    method="post">
                    <div class="modal-header">
                        <h5 class="modal-title" id="addGuestModalLabel">Add New Guest</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" asp-for="NewGuest.WeddingId" value="@Model.WeddingId" />
                        <div class="mb-3">
                            <label asp-for="NewGuest.Name" class="form-label"></label>
                            <input asp-for="NewGuest.Name" class="form-control" />
                            <span asp-validation-for="NewGuest.Name" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="NewGuest.Email" class="form-label"></label>
                            <input asp-for="NewGuest.Email" class="form-control" />
                            <span asp-validation-for="NewGuest.Email" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="NewGuest.Phone" class="form-label">Phone (Optional)</label>
                            <input asp-for="NewGuest.Phone" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label asp-for="NewGuest.Group" class="form-label"></label>
                            <select asp-for="NewGuest.Group" class="form-select">
                                <option value="">Select a group</option>
                                @if (Model.AllGroups != null)
                                {
                                    foreach (var group in Model.AllGroups)
                                    {
                                        <option value="@group">@group</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="form-check mb-3">
                            <input asp-for="NewGuest.PlusOne" class="form-check-input" />
                            <label asp-for="NewGuest.PlusOne" class="form-check-label ms-2">Allow Plus One</label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Add Guest</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
