@model HomePageModel
@{
    // This model directive might be needed if you access model properties.
    // For this static conversion, it's not strictly used by the converted HTML itself.
    // @model YourApp.Models.HomePageModel
}

<div>
    @if (ViewBag.isSetup == null || ViewBag.isSetup == false)
    {
        <div class="bg-danger-subtle rounded p-4 mb-4">
            <div class="d-flex align-items-center justify-content-between">
                <h2 class="fw-bold text-dark">Setup</h2>
                <div class="text-end">
                    <a href="/Wedding/Setup" class="btn btn-outline-danger fw-bold btn-sm mt-2">
                        <div class="fs-6 fw-bold">Config</div>
                    </a>
                </div>
            </div>
        </div>
    } else{
        <div class="bg-danger-subtle rounded p-4 mb-4">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <h2 class="fw-bold text-dark">@(Model.CurrentUser?.Couple?.Weddings?.FirstOrDefault()?.WeddingName)</h2>
                    <div class="d-flex align-items-center mt-2">
                        <i class="bi bi-calendar text-danger me-2 fs-5"></i>
                        <span class="text-muted">@(Model.CurrentUser?.Couple?.Weddings?.FirstOrDefault()?.WeddingDate.ToString("MMMM dd, yyyy"))</span>
                    </div>
                </div>
                <div class="text-end">
                    <div class="small text-muted">Days until your wedding</div>
                    <div class="display-4 fw-bold text-danger">@(Math.Round((Model.CurrentUser?.Couple?.Weddings?.FirstOrDefault()?.WeddingDate - DateTime.Now)?.TotalDays ?? 0))</div>
                </div>
            </div>
            <div class="mt-4 row text-center g-3">
                <div class="col-md-4">
                    <div class="bg-white p-3 rounded shadow-sm">
                        <i class="bi bi-currency-dollar text-success mx-auto d-block fs-4"></i>
                        <div class="mt-2 small text-muted">Budget</div>
                        <div class="fw-semibold"> @(string.Format("LKR {0:N0}",Model.CurrentUser?.Couple?.Weddings?.FirstOrDefault()?.Budget?.ActualAmount)) / @(string.Format("LKR {0:N0}",Model.CurrentUser?.Couple?.Weddings?.FirstOrDefault()?.Budget?.AllocatedAmount))</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="bg-white p-3 rounded shadow-sm">
                        <i class="bi bi-people text-primary mx-auto d-block fs-4"></i>
                        <div class="mt-2 small text-muted">Guests</div>
                        <div class="fw-semibold">@(Model.CurrentUser?.Couple?.Weddings?.FirstOrDefault()?.Guests?.Count(g => g.Status == GuestStatus.Invited.ToString()) ?? 0) Invited</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="bg-white p-3 rounded shadow-sm">
                        <i class="bi bi-clipboard-check text-info mx-auto d-block fs-4"></i>
                        <div class="mt-2 small text-muted">Tasks</div>
                        <div class="fw-semibold">@(Model.CurrentUser?.Couple?.Weddings?.FirstOrDefault()?.Tasks?.Count() ?? 0) Completed</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="fw-medium mb-0">Upcoming Tasks</h5>
                        <a href="#" class="btn btn-outline-primary btn-sm">View All</a>
                    </div>
                    <div class="card-body p-0">
                        <ul class="list-group list-group-flush">
                            @if (Model.CurrentUser?.Couple?.Weddings?.FirstOrDefault()?.Tasks != null && (Model.CurrentUser?.Couple?.Weddings?.FirstOrDefault()?.Tasks.Any() ?? false))
                            {
                                @foreach (var task in Model.CurrentUser?.Couple?.Weddings?.FirstOrDefault()?.Tasks?.OrderBy(t => t.DueDate))
                                {
                                    <li class="list-group-item py-3 d-flex align-items-center">
                                        <input type="checkbox" class="form-check-input mt-0 me-2">
                                        <div class="flex-grow-1">
                                            <p class="fw-medium mb-1">@task.Title</p>
                                            <p class="small text-muted mb-0">Due in @((task.DueDate - DateTime.Now)?.TotalDays ?? 0) days</p>
                                        </div>
                                        <span class="badge rounded-pill bg-warning-subtle text-warning-emphasis">Medium</span>
                                    </li>
                                }
                            }else{
                                @* loading place holder *@
                                <li class="list-group-item py-3 d-flex align-items-center justify-content-center">
                                    <div class="text-muted">
                                        <i class="bi bi-hourglass-split fs-3"></i>
                                        <p class="mt-2">No tasks found. Please add tasks to get started.</p>
                                    </div>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header">
                        <h5 class="fw-medium mb-0">Your Vendors</h5>
                    </div>
                    <div class="card-body">
                        <ul class="list-unstyled">
                            @if (Model.CurrentUser?.Couple?.Weddings?.FirstOrDefault()?.Vendors != null && (Model.CurrentUser?.Couple?.Weddings?.FirstOrDefault()?.Vendors.Any() ?? false))
                            {
                                @foreach (var vendor in Model.CurrentUser?.Couple?.Weddings?.FirstOrDefault()?.Vendors)
                                {
                                    <li class="d-flex align-items-center mb-3">
                                        <div class="rounded-circle bg-secondary-subtle text-secondary d-flex align-items-center justify-content-center me-3"
                                            style="width: 2.5rem; height: 2.5rem;">
                                            <i class="bi bi-shop fs-5"></i>
                                        </div>
                                        <div>
                                            <p class="fw-medium mb-1">@vendor.VendorName</p>
                                            <p class="small text-muted mb-0">@vendor.VendorType • @vendor.Status</p>
                                        </div>
                                    </li>
                                }
                            }
                            else
                            {
                                <li class="d-flex align-items-center mb-3">
                                    <div class="rounded-circle bg-secondary-subtle text-secondary d-flex align-items-center justify-content-center me-3"
                                        style="width: 2.5rem; height: 2.5rem;">
                                        <i class="bi bi-shop fs-5"></i>
                                    </div>
                                    <div>
                                        <p class="fw-medium mb-1">No vendors added yet</p>
                                        <p class="small text-muted mb-0">Please add vendors to get started</p>
                                    </div>
                                </li>
                            }
                        </ul>
                        <div class="mt-4">
                            <a href="/Vendor" class="btn btn-outline-primary d-block">Find More Vendors</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

</div>
