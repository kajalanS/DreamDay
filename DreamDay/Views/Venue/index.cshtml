@{
    ViewData["Title"] = "Venue";
    // Example Venue Data (Ideally, this would come from your Controller)
    var venues = new[] {
        new { id = 1, name = "Crystal Palace", type = "Ballroom", capacity = 300, rating = 4.8, reviewCount = 156, image = "https://images.unsplash.com/photo-1519167758481-83f550bb49b3?ixlib=rb-4.0.3", description = "Elegant ballroom venue with crystal chandeliers and modern amenities.", location = "San Francisco, CA", priceRange = "$$$", features = new[] { "Parking", "Catering Kitchen", "Bridal Suite" } },
        new { id = 2, name = "Sunset Beach Resort", type = "Beach", capacity = 200, rating = 4.9, reviewCount = 124, image = "https://images.unsplash.com/photo-1544124499-58912cbddaad?ixlib=rb-4.0.3", description = "Beautiful beachfront venue perfect for sunset ceremonies.", location = "Los Angeles, CA", priceRange = "$$$$", features = new[] { "Beach Access", "Indoor/Outdoor", "Accommodation" } },
        new { id = 3, name = "Mountain View Gardens", type = "Garden", capacity = 150, rating = 4.7, reviewCount = 98, image = "https://images.unsplash.com/photo-1464366400600-7168b8af9bc3?ixlib=rb-4.0.3", description = "Stunning garden venue with mountain backdrop.", location = "Seattle, WA", priceRange = "$$", features = new[] { "Gardens", "Covered Area", "Photo Locations" } },
        new { id = 4, name = "Historic Grand Hotel", type = "Hotel", capacity = 400, rating = 4.6, reviewCount = 178, image = "https://images.unsplash.com/photo-1519167758481-83f550bb49b3?ixlib=rb-4.0.3", description = "Iconic hotel venue with classic architecture and modern luxury.", location = "Chicago, IL", priceRange = "$$$$", features = new[] { "Accommodation", "Multiple Spaces", "Full Service" } }
    };
}
<div class="container">
    <div class="text-center mb-4">
        <h1 class="display-4 font-weight-bold text-gray-900">
            Find Your Dream Wedding Venue
        </h1>
        <p class="lead text-gray-600">
            Discover the perfect space to celebrate your special day
        </p>
    </div>

    @* Search Bar *@
    <div class="row justify-content-center mb-3">
        <div class="col-md-8">
            <div class="input-group">
                <input type="text" class="form-control form-control-lg" placeholder="Search venues..." />
                    <button class="btn btn-outline-secondary" type="button">
                        Search
                    </button>
            </div>
        </div>
    </div>

    <div class="row">
        @* Filters Sidebar *@
        <div class="col-md-3">
            @*  Consider creating a partial view for the filter *@
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Filters</h5>
                    @* Add filter controls here (e.g., dropdowns, checkboxes) *@
                    <label for="venueType">Venue Type:</label>
                    <select class="form-control" id="venueType">
                        <option value="all">All</option>
                        <option value="ballroom">Ballroom</option>
                        <option value="beach">Beach</option>
                        <option value="garden">Garden</option>
                        <option value="hotel">Hotel</option>
                    </select>
                    <label for="location">Location:</label>
                    <select class="form-control" id="location">
                        <option value="all">All</option>
                        <option value="sanFrancisco">San Francisco</option>
                        <option value="losAngeles">Los Angeles</option>
                        <option value="seattle">Seattle</option>
                        <option value="chicago">Chicago</option>
                    </select>
                    <label for="priceRange">Price Range:</label>
                    <select class="form-control" id="priceRange">
                        <option value="all">All</option>
                        <option value="low">Low</option>
                        <option value="medium">Medium</option>
                        <option value="high">High</option>
                    </select>
                </div>
            </div>
        </div>

        @* Venue Grid *@
        <div class="col-md-9">
            <div class="row row-cols-1 row-cols-md-2 g-4">
                @foreach (var venue in venues)
                {
                    <div class="col">
                        <div class="card h-100">
                            <img src="@venue.image" class="object-fit-cover" style="height: 12rem;" alt="@venue.name">
                            <div class="card-body">
                                <h5 class="card-title">@venue.name</h5>
                                <p class="card-text">@venue.description</p>
                                <p class="card-text"><small class="text-muted">@venue.location</small></p>
                            </div>
                            <div class="card-footer">
                                <small class="text-muted">Rating: @venue.rating</small>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
