                            <div class="p-4 bg-rose-50 rounded-lg">
                                <p class="text-3xl font-bold text-rose-600">@Model.AdminStates?.Couples</p>
                                <p class="text-sm text-gray-600">Active Couples</p>
                            </div>
                        </div>
                        <div class="col">
