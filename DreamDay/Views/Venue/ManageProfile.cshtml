@* @model DreamDay.Models.View.VenueProfilePageModel
@{
    ViewData["Title"] = "Venue";
    // Fix: Only the venue owner can edit (readOnly = false for owner)
    var readOnly = !(Model.UserRole == UserType.Vendor && Model.CurrentUser?.Id == Model.Venue.Vendor.UserId);
    var venueAlreadyExists = Model.Venue != null && Model.CurrentUser?.Couple.Weddings.FirstOrDefault().Venue != null && Model.Venue.WeddingVenues.Any();
}


<form method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <div class="row">
        <div class="col">
            <h1>@ViewData["Title"]</h1>
        </div>
        <div class="col-auto text-end d-flex justify-content-center align-items-center">
            @if (!readOnly)
            {
                <div class="gap-2">
                    <button type="submit" class="btn btn-primary">Save Profile</button>
                    <a href="/Venue" class="btn btn-secondary">Cancel</a>
                </div>
            }
            @if (Model.UserRole == UserType.Couple)
            {
                @if (venueAlreadyExists)
                {
                    <a type="button" class="btn btn-primary"
                        href="@Url.Action("Remove", "Venue", new { id = Model.Venue.Id })">Remove Venue</a>
                }
                else
                {
                    <a type="button" class="btn btn-primary" href="@Url.Action("Add", "Venue", new { id = Model.Venue.Id })">Add
                        Venue</a>
                }
            }
        </div>
    </div>
    <hr />
    <!-- Validation summary -->
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

    <div class="row">
        <div class="col">
            <!-- Basic Info -->
            <div class="card mb-3">
                <div class="card-header">Basic Information</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="VenueName" class="form-label"></label>
                        <input readonly="@readOnly" type="text" class="form-control" asp-for="VenueName" />
                        <span asp-validation-for="VenueName" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea readonly="@readOnly" class="form-control" rows="5" asp-for="Description"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="ContactEmail" class="form-label"></label>
                            <input readonly="@readOnly" type="email" class="form-control" asp-for="ContactEmail" />
                            <span asp-validation-for="ContactEmail" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="PhoneNumber" class="form-label"></label>
                            <input readonly="@readOnly" type="tel" class="form-control" asp-for="PhoneNumber" />
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="WebsiteURL" class="form-label"></label>
                        <input readonly="@readOnly" type="url" class="form-control" placeholder="https://..."
                            asp-for="WebsiteURL" />
                        <span asp-validation-for="WebsiteURL" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <!-- Add any page-specific scripts if needed -->
} *@
