@model HomePageModel
@{
    ViewBag.Title = "Admin Page";
}

<div class="space-y-6">
    <!-- Vendor Applications Card -->
    <div class="card mb-3">
        <div class="card-header">
            <h3 class="text-lg font-medium">Vendor Applications</h3>
        </div>
        <div class="card-body">
            <div class="divide-y divide-gray-200">
                @if (Model.VendorPage.Vendors == null || !Model.VendorPage.Vendors.Any())
                {
                    <li class="list-group-item text-center py-5">
                        <div class="text-muted">No Vendors Found!.</div>
                    </li>
                }
                @foreach (var vendor in Model.VendorPage.Vendors)
                {
                    <div class="py-4 d-flex justify-content-between align-items-center">
                        <div>
                            <h4 class="font-medium">@vendor?.VendorName</h4>
                            <p class="text-sm text-gray-500">
                                @vendor.VendorType?.Category
                            </p>
                        </div>
                        <div class="space-x-2">
                            @if (vendor?.Status == VendorStatus.Pending)
                            {
                                <a href="@Url.Action("Reject", "Vendor", new { id = vendor.Id })"
                                    class="btn btn-outline-secondary btn-sm">Reject</a>
                                <a href="@Url.Action("Approve", "Vendor", new { id = vendor.Id })"
                                    class="btn btn-primary btn-sm">Approve</a>
                            }
                            else if (vendor?.Status == VendorStatus.Active)
                            {
                                <a href="@Url.Action("Reject", "Vendor", new { id = vendor.Id })"
                                    class="btn btn-outline-secondary btn-sm">Reject</a>
                            }
                            else if (vendor?.Status == VendorStatus.Suspended)
                            {
                                @* <span class="text-warning">Suspended</span> *@
                                <a href="@Url.Action("Approve", "Vendor", new { id = vendor.Id })"
                                    class="btn btn-primary btn-sm">Reactivate</a>
                            }
                        </div>
                    </div>
                }
                @* <hr />
                <div class="py-4 d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="font-medium">Golden Gate Catering</h4>
                        <p class="text-sm text-gray-500">
                            Catering • Applied 3 days ago
                        </p>
                    </div>
                    <div class="space-x-2">
                        <button class="btn btn-outline-secondary btn-sm">
                            Reject
                        </button>
                        <button class="btn btn-primary btn-sm">Approve</button>
                    </div>
                </div>
                <hr />
                <div class="py-4 d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="font-medium">Harmony Wedding Music</h4>
                        <p class="text-sm text-gray-500">
                            Music • Applied 5 days ago
                        </p>
                    </div>
                    <div class="space-x-2">
                        <button class="btn btn-outline-secondary btn-sm">
                            Reject
                        </button>
                        <button class="btn btn-primary btn-sm">Approve</button>
                    </div>
                </div> *@
            </div>
        </div>
    </div>
    <div class="row row-cols-1 g-6">
