@using DreamDay.Models
@model HomePageModel

@functions {
    string GetRsvpStatusBadgeClass(string status)
    {
        return status?.ToLower() switch
        {
            "confirmed" => "bg-success-subtle text-success-emphasis",
            "declined" => "bg-danger-subtle text-danger-emphasis",
            _ => "bg-warning-subtle text-warning-emphasis",
        };
    }
}

@if (Model?.GuestList == null)
{
    <div class="alert alert-warning">
        No guest data available.
    </div>
    return;
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 fw-bold text-dark">Guest List</h1>
            <p class="mt-1 text-muted small">
                Manage your wedding guests and track RSVPs
            </p>
        </div>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addGuestModal">
            <i class="bi bi-plus-lg me-2"></i>Add Guest
        </button>
    </div>

    <!-- Guest Statistics -->
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-3 mb-4">
        <div class="col">
            <div class="card shadow-sm">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-light p-3 me-3">
                        <i class="bi bi-people fs-4 text-secondary"></i>
                    </div>
                    <div>
                        <h3 class="small text-muted mb-0">Total Guests</h3>
                        <p class="fs-4 fw-semibold text-dark mb-0">@(Model.GuestList.GuestStats?.Total ?? 0)</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card shadow-sm">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-success-subtle p-3 me-3">
                        <i class="bi bi-check-circle fs-4 text-success"></i>
                    </div>
                    <div>
                        <h3 class="small text-muted mb-0">Confirmed</h3>
                        <p class="fs-4 fw-semibold text-dark mb-0">@Model.GuestList.GuestStats?.Confirmed</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card shadow-sm">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-warning-subtle p-3 me-3">
                        <i class="bi bi-hourglass-split fs-4 text-warning"></i>
                    </div>
                    <div>
                        <h3 class="small text-muted mb-0">Pending</h3>
                        <p class="fs-4 fw-semibold text-dark mb-0">@Model.GuestList.GuestStats?.Pending</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card shadow-sm">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-danger-subtle p-3 me-3">
                        <i class="bi bi-x-circle fs-4 text-danger"></i>
                    </div>
                    <div>
                        <h3 class="small text-muted mb-0">Declined</h3>
                        <p class="fs-4 fw-semibold text-dark mb-0">@Model.GuestList.GuestStats?.Declined</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Search and Filter -->
    @* Assuming this form submits via GET to the current page/action for filtering *@
    <form method="get" action="">
        <div class="d-flex flex-column flex-md-row gap-3 mb-4">
            <div class="input-group flex-grow-1">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" name="searchQuery" placeholder="Search guests..." value="@(Model.GuestList.SearchQuery ?? "")" class="form-control" />
            </div>
            <select name="selectedGroup" class="form-select w-auto" onchange="this.form.submit()">
                <option value="all" selected="@("all" == Model.GuestList.SelectedGroup)">All Groups</option>
                @if (Model.GuestList.AllGroups?.Any() == true)
                {
                    foreach (var group in Model.GuestList.AllGroups)
                    {
                        <option value="@group" selected="@(group == Model.GuestList.SelectedGroup)">@group</option>
                    }
                }
            </select>
            <button type="submit" class="btn btn-outline-secondary">Filter</button>
        </div>
    </form>

    <!-- Guest List -->
    <div class="card shadow-sm">
        <div class="card-header">
            <h2 class="h5 mb-0 text-dark">Guests</h2>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="px-3 py-2 text-start text-uppercase small text-muted">Name</th>
                            <th class="px-3 py-2 text-start text-uppercase small text-muted">Contact</th>
                            <th class="px-3 py-2 text-start text-uppercase small text-muted">Group</th>
                            <th class="px-3 py-2 text-start text-uppercase small text-muted">RSVP Status</th>
                            <th class="px-3 py-2 text-start text-uppercase small text-muted">Plus One</th>
                            <th class="px-3 py-2 text-start text-uppercase small text-muted">Table</th>
                            <th class="px-3 py-2 text-end text-uppercase small text-muted">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.GuestList.Guests != null && Model.GuestList.Guests.Any())
                        {
                            foreach (var guest in Model.GuestList.Guests)
                            {
                                <tr>
                                    <td class="px-3 py-2 text-nowrap">
                                        <div class="fw-medium text-dark">@guest.Name</div>
                                    </td>
                                    <td class="px-3 py-2">
                                        <div class="small text-muted">@guest.Email</div>
                                        @if (!string.IsNullOrEmpty(guest.Phone))
                                        {
                                            <div class="small text-muted">@guest.Phone</div>
                                        }
                                    </td>
                                    <td class="px-3 py-2 text-nowrap">
                                        <div class="small text-muted">@(guest.Group ?? "-")</div>
                                    </td>
                                    <td class="px-3 py-2 text-nowrap">
                                        <span class="badge rounded-pill @GetRsvpStatusBadgeClass(guest.RsvpStatus)">
                                            @guest.RsvpStatus?.ToUpperInvariant()
                                        </span>
                                    </td>
                                    <td class="px-3 py-2 small text-muted">@(guest.PlusOne ? "Yes" : "No")</td>
                                    <td class="px-3 py-2 small text-muted">@(guest.TableAssignment?.ToString() ?? "-")</td>
                                    <td class="px-3 py-2 text-nowrap text-end">
                                        <a href="mailto:@guest.Email" class="btn btn-sm btn-outline-secondary me-1" title="Send Email">
                                            <i class="bi bi-envelope"></i>
                                        </a>
                                        <a href="#" class="btn btn-sm btn-outline-secondary" title="Edit Guest">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center p-4 text-muted">No guests found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
