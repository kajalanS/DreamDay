<div class="container">
    <div class="row">
        <div class="col-md-12">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Title</th>
                        <th>Theme</th>
                        <th>Number Of Guests</th>
                        <th>Groom Name</th>
                        <th>Bride Name</th>
                        <th>Wedding Date</th>
                        <th>Engagement Date</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var wedding in Model.Weddings)
                    {
                        <tr>
                            <td>@wedding.Id</td>
                            <td>@wedding.WeddingName</td>
                            <td>@wedding.Theme</td>
                            <td>@wedding.NumberOfGuests</td>
                            <td>@(wedding.Couple?.GroomName ?? "N/A")</td>
                            <td>@(wedding.Couple?.BrideName ?? "N/A")</td>
                            <td>@wedding.WeddingDate.ToShortDateString()</td>
                            <td>@(wedding.Couple?.EngagementDate?.ToShortDateString() ?? "N/A")</td>
                            <td>@wedding.Status</td>
                            @if (wedding.Couple?.UserId != null && Model.CurrentUser?.Id != null && wedding.Couple.UserId ==
                                                    Model.CurrentUser.Id)
                            {
                                <td>
                                    <a class="text-decoration-none" asp-action="Delete" asp-route-id="@wedding.Id">
                                        <button type="button" class="btn btn-outline-danger">
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18"
                                                fill="currentColor">
                                                <path fill="none" d="M0 0h24v24H0z"></path>
                                                <path
                                                    d="M17 4H22V6H20V21C20 21.5523 19.5523 22 19 22H5C4.44772 22 4 21.5523 4 21V6H2V4H7V2H17V4ZM9 9V17H11V9H9ZM13 9V17H15V9H13Z">
                                                </path>
                                            </svg>
                                        </button>
                                    </a>
                                    <a class="text-decoration-none" asp-action="Details" asp-route-id="@wedding.Id">
                                        <button type="button" class="btn btn-outline-primary">
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18"
                                                fill="currentColor">
                                                <path fill="none" d="M0 0h24v24H0z"></path>
                                                <path
                                                    d="M1 5C1 4.44772 1.44772 4 2 4H22C22.5523 4 23 4.44772 23 5V19C23 19.5523 22.5523 20 22 20H2C1.44772 20 1 19.5523 1 19V5ZM9 8H7V10H9V8ZM7 13V16H9V11H6V13H7ZM13 9V11H19V9H13ZM18 13H13V15H18V13Z">
                                                </path>
                                            </svg>
                                        </button>
                                    </a>
                                </td>
                            }
                            else
                            {
                                <td>
                                    <a class="text-decoration-none" asp-action="Details" asp-route-id="@wedding.Id">
                                        <button type="button" class="btn btn-outline-primary">
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18"
                                                fill="currentColor">
                                                <path fill="none" d="M0 0h24v24H0z"></path>
                                                <path
                                                    d="M1 5C1 4.44772 1.44772 4 2 4H22C22.5523 4 23 4.44772 23 5V19C23 19.5523 22.5523 20 22 20H2C1.44772 20 1 19.5523 1 19V5ZM9 8H7V10H9V8ZM7 13V16H9V11H6V13H7ZM13 9V11H19V9H13ZM18 13H13V15H18V13Z">
                                                </path>
                                            </svg>
                                        </button>
                                    </a>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<br />
<hr />

<h1>Wedding Plan: [Wedding Name/Couple Names]</h1>
<hr />

<div class="row">
    <!-- Wedding Overview -->
    <div class="col-md-4">
        <div class="card mb-3">
            <div class="card-header">
                Wedding Overview
                <!-- Edit link (asp-action="EditWedding", asp-route-id="[at]Model.WeddingId") -->
                <a href="#" class="btn btn-sm btn-outline-primary float-end">Edit</a>
            </div>
            <div class="card-body">
                <p><strong>Date:</strong> [Wedding Date]</p>
                <p><strong>Status:</strong> <span class="badge bg-info">[Wedding Status e.g., Planning]</span></p>
                <p><strong>Budget:</strong> $[Total Budget]</p>
                <p><strong>Guest Count:</strong> [Estimated Guests]</p>
                <p><strong>Venue:</strong> [Venue Name or 'Not Booked'] <a href="#">(Book/Change)</a></p>
                <!-- Planner/Vendor Info -->
                <p><strong>Planner:</strong> [Vendor Name or 'None'] <a href="#">(Invite Vendor)</a></p>
            </div>
        </div>
    </div>

    <!-- Budget Breakdown -->
    <div class="col-md-4">
        <div class="card mb-3">
            <div class="card-header">
                Budget Tracker
                <a href="#" class="btn btn-sm btn-outline-success float-end">Add Item</a>
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        Venue Rental
                        <span>$5,000 / $6,000</span>
                        <div>
                            <a href="#" class="btn btn-sm btn-outline-secondary">E</a> <!-- Edit -->
                            <a href="#" class="btn btn-sm btn-outline-danger">D</a> <!-- Delete -->
                        </div>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        Catering
                        <span>$3,500 / $4,000</span>
                        <div>
                            <a href="#" class="btn btn-sm btn-outline-secondary">E</a>
                            <a href="#" class="btn btn-sm btn-outline-danger">D</a>
                        </div>
                    </li>
                </ul>
                <div class="mt-2 fw-bold">Total Spent: $[Total Spent] / $[Total Budget]</div>
            </div>
        </div>
    </div>

    <!-- Task List -->
    <div class="col-md-4">
        <div class="card mb-3">
            <div class="card-header">
                Task List
                <a href="#" class="btn btn-sm btn-outline-success float-end">Add Task</a>
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" value="" id="task1">
                            <label class="form-check-label" for="task1">
                                Book Photographer <span class="text-muted small">(Due: 2023-12-01)</span>
                            </label>
                            <a href="#" class="btn btn-sm btn-outline-secondary float-end ms-1">E</a>
                            <a href="#" class="btn btn-sm btn-outline-danger float-end">D</a>
                        </div>
                    </li>
                    <li class="list-group-item">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" value="" id="task2" checked>
                            <label class="form-check-label" for="task2">
                                Send Save-the-Dates <span class="text-muted small">(Due: 2023-11-15)</span>
                            </label>
                            <a href="#" class="btn btn-sm btn-outline-secondary float-end ms-1">E</a>
                            <a href="#" class="btn btn-sm btn-outline-danger float-end">D</a>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Guest List / RSVP -->
    <div class="col-md-12">
        <div class="card mb-3">
            <div class="card-header">
                Guest List & RSVP
                <a href="#" class="btn btn-sm btn-outline-success float-end ms-2">Add Guest</a>
                <a href="#" class="btn btn-sm btn-outline-secondary float-end">Import Guests</a>
            </div>
            <div class="card-body">
                <div class="mb-2">
                    <strong>RSVP Summary:</strong> [Attending Count] Attending, [Declined Count] Declined, [Pending
                    Count] Pending
                </div>
                <table class="table table-sm table-hover">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Party Size</th>
                            <th>RSVP Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Alice Wonderland</td>
                            <td>2</td>
                            <td><span class="badge bg-success">Attending</span></td>
                            <td>
                                <a href="#" class="btn btn-sm btn-outline-secondary">Edit</a>
                                <a href="#" class="btn btn-sm btn-outline-danger">Delete</a>
                            </td>
                        </tr>
                        <tr>
                            <td>Bob The Builder</td>
                            <td>1</td>
                            <td><span class="badge bg-secondary">Pending</span></td>
                            <td>
                                <a href="#" class="btn btn-sm btn-outline-secondary">Edit</a>
                                <a href="#" class="btn btn-sm btn-outline-danger">Delete</a>
                            </td>
                        </tr>
                        <tr>
                            <td>Charlie Chaplin</td>
                            <td>2</td>
                            <td><span class="badge bg-danger">Declined</span></td>
                            <td>
                                <a href="#" class="btn btn-sm btn-outline-secondary">Edit</a>
                                <a href="#" class="btn btn-sm btn-outline-danger">Delete</a>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Add sections for Vendors involved, etc. -->
