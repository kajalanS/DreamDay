<div class="container">
    <div class="row">
        <div class="col-md-12">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Title</th>
                        <th>Theme</th>
                        <th>Number Of Guests</th>
                        <th>Groom Name</th>
                        <th>Bride Name</th>
                        <th>Wedding Date</th>
                        <th>Engagement Date</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Weddings == null || !Model.Weddings.Any())
                    {
                        <tr>
                            <td colspan="10" class="text-center">No weddings found.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var wedding in Model.Weddings)
                        {
                            <tr>
                                <td>@wedding.Id</td>
                                <td>@wedding.WeddingName</td>
                                <td>@wedding.Theme</td>
                                <td>@wedding.NumberOfGuests</td>
                                <td>@(wedding.Couple?.GroomName ?? "N/A")</td>
                                <td>@(wedding.Couple?.BrideName ?? "N/A")</td>
                                <td>@wedding.WeddingDate.ToShortDateString()</td>
                                <td>@(wedding.Couple?.EngagementDate?.ToShortDateString() ?? "N/A")</td>
                                <td>@wedding.Status</td>
                                @if (wedding.Couple?.UserId != null && Model.CurrentUser?.Id != null && wedding.Couple.UserId ==
                                                        Model.CurrentUser.Id)
                                {
                                    <td>
                                        <a class="text-decoration-none" asp-action="Delete" asp-route-id="@wedding.Id">
                                            <button type="button" class="btn btn-outline-danger">
                                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18"
                                                    fill="currentColor">
                                                    <path fill="none" d="M0 0h24v24H0z"></path>
                                                    <path
                                                        d="M17 4H22V6H20V21C20 21.5523 19.5523 22 19 22H5C4.44772 22 4 21.5523 4 21V6H2V4H7V2H17V4ZM9 9V17H11V9H9ZM13 9V17H15V9H13Z">
                                                    </path>
                                                </svg>
                                            </button>
                                        </a>
                                        <a class="text-decoration-none" asp-action="Details" asp-route-id="@wedding.Id">
                                            <button type="button" class="btn btn-outline-primary">
                                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18"
                                                    fill="currentColor">
                                                    <path fill="none" d="M0 0h24v24H0z"></path>
                                                    <path
                                                        d="M1 5C1 4.44772 1.44772 4 2 4H22C22.5523 4 23 4.44772 23 5V19C23 19.5523 22.5523 20 22 20H2C1.44772 20 1 19.5523 1 19V5ZM9 8H7V10H9V8ZM7 13V16H9V11H6V13H7ZM13 9V11H19V9H13ZM18 13H13V15H18V13Z">
                                                    </path>
                                                </svg>
                                            </button>
                                        </a>
                                    </td>
                                }
                                else
                                {
                                    <td>
                                        <a class="text-decoration-none" asp-action="Details" asp-route-id="@wedding.Id">
                                            <button type="button" class="btn btn-outline-primary">
                                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18"
                                                    fill="currentColor">
                                                    <path fill="none" d="M0 0h24v24H0z"></path>
                                                    <path
                                                        d="M1 5C1 4.44772 1.44772 4 2 4H22C22.5523 4 23 4.44772 23 5V19C23 19.5523 22.5523 20 22 20H2C1.44772 20 1 19.5523 1 19V5ZM9 8H7V10H9V8ZM7 13V16H9V11H6V13H7ZM13 9V11H19V9H13ZM18 13H13V15H18V13Z">
                                                    </path>
                                                </svg>
                                            </button>
                                        </a>
                                    </td>
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
