<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DreamDay</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DreamDay.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/remixicon/remixicon.min.css" />
    <style>
        body {
            padding-top: 58px;
            overflow-y: hidden;
        }

        .sidebar {
            width: 4.8rem;
            position: fixed;
            top: 56px;
            bottom: 56px;
            left: 0;
            background-color: #f8f9fa;
            overflow-y: auto;
        }

        .main-content {
            margin-left: 4.5rem;
            height: calc(100vh - 112px);
            overflow-y: auto;
        }

        main {
            overflow: auto !important;
        }

        .footer {
            position: fixed;
            bottom: 0;
            width: 100%;
            height: 56px;
            background-color: #fff;
            border-top: 1px solid #dee2e6;
            display: flex;
            align-items: center;
            justify-content: center;
        }
    </style>
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom shadow-sm fixed-top">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">DreamDay</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                    aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home"
                                asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-auto p-0">
                <partial name="_SideBar" />
            </div>
            <!-- Main Content -->
            <div class="col p-0 main-content">
                <main role="main" class="p-0">
                    <div class="p-4 w-100 h-100">
                        @RenderBody()
                    </div>
                </main>
            </div>
        </div>
    </div>

    <footer class="footer text-muted shadow-sm">
        <div class="container">
            &copy; 2025 - DreamDay - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
